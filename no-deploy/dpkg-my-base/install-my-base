#!/usr/bin/env python3
"""Generate, build, and install the local Debian meta-package."""

from pathlib import Path
import subprocess


PACKAGE_DIRECTORY = Path(__file__).resolve().parent
PACKAGE_NAME = "my-base-meta"
PACKAGE_VERSION = "0.1.5"

DEPENDENCIES = (
    "ansible-core", "avfs",
    "bat", "build-essential", "busybox",
    "cmark", "cowsay",
    "diffutils",
    "eza",
    "fd-find", "fzf",
    "gh", "git", "git-delta", "goaccess",
    "minisign",
    "reptyr", "ripgrep", "rsync", "ruby",
    "subversion",
    "texinfo", "tmux", "trash-cli",
    "vim",
    "wget",
    "zsh",

    # man-db provides the reader utility; manpages provides the manual data.
    "man-db", "manpages",
)

COMMAND_DEPENDENCIES = (
    # Command: checkservices
    "needrestart",

    # Command: psql
    "postgresql-client",
)


def generate_control() -> None:
    packages = DEPENDENCIES + COMMAND_DEPENDENCIES
    if len(packages) != len(set(packages)):
        raise ValueError("A package appears more than once in dependencies")

    depends = f"Depends: {', '.join(packages)}"

    fields = (
        f"Package: {PACKAGE_NAME}",
        f"Version: {PACKAGE_VERSION}",
        "Section: metapackages",
        "Priority: optional",
        "Architecture: all",
        "Maintainer: Franklin Yu <franklinyu@google.com>",
        "Description: packages I want for every Debian install",
        " Personal meta-package for commonly used packages.",
        depends,
        "",
    )

    control_path = PACKAGE_DIRECTORY / "generated" / "DEBIAN" / "control"
    control_path.parent.mkdir(parents=True, exist_ok=True)
    control_path.write_text("\n".join(fields), encoding="utf-8")


def main() -> None:
    generate_control()
    subprocess.run(
        ["dpkg-deb", "--build", "--root-owner-group", "generated", f"{PACKAGE_NAME}.deb"],
        cwd=PACKAGE_DIRECTORY,
        check=True,
    )
    subprocess.run(
        ["sudo", "apt", "install", f"./{PACKAGE_NAME}.deb"],
        cwd=PACKAGE_DIRECTORY,
        check=True,
    )


if __name__ == "__main__":
    main()
