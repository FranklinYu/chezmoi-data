<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>name.franklin-yu.gui-path</string>
	<!-- Start with a fresh PATH when reloading the agent. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string></string>
	</dict>
	<!-- Apps opened from Finder or the Dock normally start without a login shell,
	     so they do not automatically read ~/.profile. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<!-- -l starts a login shell, which reads /etc/profile and ~/.profile
		     before the command publishes PATH to the GUI session. -->
		<string>-lc</string>
		<string>exec /bin/launchctl setenv PATH "$PATH"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
